# Atlas
# MONGO_URI=mongodb+srv://<USER_ID>:<PASSWORD>@???.mongodb.net/?appName=???

# Local MongoDB
# MONGO_URI=mongodb://localhost:27017
MONGO_URI=<MUST BE SPECIFIED>

# Database name in use
# 使用データベース
USERS_DB_NAME=revlm

# User collection name (stores user information)
# ユーザコレクション名（ユーザー情報を格納します）
USERS_COLLECTION_NAME=users

# JWT secret used to sign access tokens
# アクセストークンに署名するための秘密鍵
JWT_SECRET=example-secret

# Secret key used to sign short-lived refresh tokens
# リフレッシュ用の短命トークン署名するための秘密鍵
REFRESH_SECRET_SIGNING_KEY=example-refresh-secret

PORT=4122

# Specify the URL where the app is running (used for CORS settings, etc.). Multiple
# アプリが動作しているURLを指定する（CORS設定などで使用）カンマ区切りで複数の記述が可能
#CORS_ORIGIN=https://xxx.yyy.zzz

# Disable Secure cookie for HTTP demo usage (set to true/omit for HTTPS).
# HTTPデモ用にSecure属性を無効化（HTTPSでは true または未設定）。
COOKIE_SECURE=true

# SameSite setting for cookies (none|lax|strict). Use "none" for cross-site browser demos.
# SameSite設定（none|lax|strict）。ブラウザのクロスサイトデモは "none" 推奨。
COOKIE_SAMESITE=none

# [Provisional Login] allows Revlm-Server to create initial accounts and users using provisional credentials.
# [Provisional Login] は、Revlm-Server が暫定的な認証情報（provisional credentials）を利用して、
# 初期アカウントおよびユーザの作成を許可するための機構です。

# Enables or disables Provisional Login
# Provisional Login の有効／無効を指定
PROVISIONAL_LOGIN_ENABLED=true

# Provisional authentication ID
# Provisional Login で使用する暫定認証ID
PROVISIONAL_AUTH_ID=example-prov

# Master secret for provisional authentication
# Provisional Login で使用するマスターシークレット
PROVISIONAL_AUTH_SECRET_MASTER=example-master

# Domain used for provisional authentication
# Provisional Login で使用するドメイン
PROVISIONAL_AUTH_DOMAIN=example.domain

# Access token expiration time (seconds)
# Access Token の有効期限（秒単位）
JWT_EXPIRES_IN=600

# Additional grace period after refresh token expiration (seconds)
# Refresh is allowed during this window. 0 means unlimited.
# リフレッシュトークンが期限切れになった後、追加で許容される猶予時間（秒）
# この期間内であれば、期限切れ後でもリフレッシュ可能
# 0 を指定した場合無期限となる
REFRESH_WINDOW_SEC=300

# Lifetime of the refresh secret itself (seconds)
# Once expired, refresh becomes impossible. 0 means unlimited.
# REFRESH_SECRET_SIGNING_KEY の有効期間（秒）
# この時間を過ぎるとシークレットそのものが廃棄され、リフレッシュ不能となる
# 0 を指定した場合無期限となる
REFRESH_SECRET_TTL_SEC=300

# By setting REFRESH_SECRET_TTL_SEC=0 and REFRESH_WINDOW_SEC=0, and enabling autoRefreshOn401=true in Revlm-Client, you can operate without worrying about access token expiration. This is particularly useful for mobile apps.
# REFRESH_SECRET_TTL_SEC=0、REFRESH_WINDOW_SEC=0 とし、Revlm-Client の autoRefreshOn401=true を設定することで、アクセストークンの有効期限を意識せずに運用できます。スマートフォンアプリなどで有効です。

# Maximum request body size
# Exceeding this limit triggers PayloadTooLargeError
# リクエスト本体（body）の最大サイズ
# これを超えると PayloadTooLargeError が発生する
BODY_LIMIT=1mb

# Lifetime of stored session data (seconds). 0 means unlimited.
# 保存されたセッション情報の有効期間（秒）
# 0 を指定した場合無期限となる
REFRESH_SESSION_TTL_SEC=2592000

# Emit a WARN log when the request body exceeds this threshold
# リクエスト本体がこのしきい値を超えると、警告ログ（WARN）を出す
BODY_WARN_THRESHOLD=100kb

# Log level (debug / info / warn / error)
# ログレベルの指定（debug / info / warn / error）
LOG_LEVEL=debug
