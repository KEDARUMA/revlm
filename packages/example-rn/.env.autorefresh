# Revlm server base URL for the client.
# クライアントが接続するRevlmサーバのベースURL。
REVLM_BASE_URL=https://localhost:4123

# Database name used by the client.
# クライアントが使用するデータベース名。
USERS_DB_NAME=revlm

# Session ID for multi-session support (preferably a UUID)
# マルチセッション用のセッションID (UUIDなどが望ましい)
RN_REVLM_SESSION_ID=example-rn-session

# Enable provisional login flow in the demo.
# デモで仮ログインを有効化。
PROVISIONAL_LOGIN_ENABLED=true

# Provisional auth ID.
# 仮ログインの認証ID。
PROVISIONAL_AUTH_ID=example-prov

# Provisional auth master secret.
# 仮ログインのマスターシークレット。
PROVISIONAL_AUTH_SECRET_MASTER=example-master

# Provisional auth domain.
# 仮ログインのドメイン。
PROVISIONAL_AUTH_DOMAIN=example.domain

# Automatically refresh on 401 responses.
# 401時の自動リフレッシュを有効化。
AUTO_REFRESH_ON_401=true

# Client log level.
# クライアントのログレベル。
LOG_LEVEL=debug
