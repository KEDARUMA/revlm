# Revlm server base URL for the client.
# クライアントが接続するRevlmサーバのベースURL。
VITE_REVLM_BASE_URL=https://localhost:4123

# Database name used by the client.
# クライアントが使用するデータベース名。
VITE_USERS_DB_NAME=revlm

# Session ID for multi-session support (preferably a UUID)
# マルチセッション用のセッションID (UUIDなどが望ましい)
VITE_VUE_REVLM_SESSION_ID=example-vue-session

# Enable provisional login flow in the demo.
# デモで仮ログインを有効化。
VITE_PROVISIONAL_LOGIN_ENABLED=true

# Provisional auth ID.
# 仮ログインの認証ID。
VITE_PROVISIONAL_AUTH_ID=example-prov

# Provisional auth master secret.
# 仮ログインのマスターシークレット。
VITE_PROVISIONAL_AUTH_SECRET_MASTER=example-master

# Provisional auth domain.
# 仮ログインのドメイン。
VITE_PROVISIONAL_AUTH_DOMAIN=example.domain

# Automatically refresh on 401 responses.
# 401時の自動リフレッシュを有効化。
VITE_AUTO_REFRESH_ON_401=false

# Client log level.
# クライアントのログレベル。
VITE_LOG_LEVEL=debug
